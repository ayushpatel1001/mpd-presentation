  "minGapSec": 0.2,
  "lines": [
   {
    "id": "c1_l1",
    "act": "act1",
    "start": 0.8,
    "text": "Resins your production can count on."
   },
   {
    "id": "c1_l2",
    "act": "act1",
    "start": 4.4,
    "text": "{MPD|M P D} Industries, {Ujjain|oo jane}: {22|twenty-two} reactors, nearly {83,000|eighty-three thousand} tons a year, built to keep your lines running."
   },
   {
    "id": "c2_l1",
    "act": "act2",
    "start": 15.4,
    "text": "Plant {1|one} makes saturated polyester, alkyds and modified epoxy, in reactors up to {16 KL|sixteen kiloliters}."
   },
   {
    "id": "c2_l2",
    "act": "act2",
    "start": 23.2,
    "text": "Plant {2|two} adds reactive polyamides, powder polyesters, acrylic polyols and phenolics, as flakes or pellets."
   },
   {
    "id": "c2_l3",
    "act": "act2",
    "start": 31.6,
    "text": "Need a custom grade? We develop it with you, from {2 KL|two kiloliter} trials to full batches."
   },
   {
    "id": "c3_l1",
    "act": "act3",
    "start": 39.8,
    "text": "And supply you can plan around: raw materials stocked in bulk, and {600 KL|six hundred kiloliters} of solvents underground."
   },
   {
    "id": "c3_l2",
    "act": "act3",
    "start": 47.3,
    "text": "Over {1,000 KL|one thousand kiloliters} of finished resin waits in {22|twenty-two} grade-dedicated tanks, ready to ship."
   },
   {
    "id": "c3_l3",
    "act": "act3",
    "start": 54.3,
    "text": "Short lead times. Steady deliveries."
   },
   {
    "id": "c4_l1",
    "act": "act4",
    "start": 58.6,
    "text": "Recipe-driven automation makes every batch match the last."
   },
   {
    "id": "c4_l2",
    "act": "act4",
    "start": 63.2,
    "text": "Our {QC|Q C} lab releases each one, and our application lab tests it the way you will use it."
   },
   {
    "id": "c5_l1",
    "act": "act5",
    "start": 71.7,
    "text": "Heat from agro-waste biomass, not coal. {0.7 MW|Point seven megawatts} of rooftop solar. Effluent treated on site."
   },
   {
    "id": "c5_l2",
    "act": "act5",
    "start": 80.6,
    "text": "Lower-carbon resin for your sustainability goals."
   },
   {
    "id": "c6_l1",
    "act": "act6",
    "start": 85.0,
    "text": "Reliable supply, consistent quality, and technical support from people who know your process."
   },
   {
    "id": "c6_l2",
    "act": "act6",
    "start": 96.4,
    "text": "{MPD|M P D} Industries. We innovate. We serve."
   }
  ],
  "$comment": "{display|spoken} pairs keep captions exact while TTS gets a respelling. Gemini clips are sped up by voice.tempo (pitch kept) for a brisker read."
