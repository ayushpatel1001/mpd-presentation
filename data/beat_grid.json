  "narration": {
    "$comment": "{display|spoken} pairs keep on-screen captions exact while the TTS engine gets a phonetic respelling. 'start' is the earliest start; lines are snapped to the half-beat grid and pushed later if the previous line is still speaking.",
    "voice": { "engine": "rhvoice", "profile": "bdl", "rate": 100, "pitch": 100 },
    "minGapSec": 0.35,
    "lines": [
      { "id": "a1_l1", "act": "act1", "start": 4.21875, "text": "Looking for scale, safety, and dedicated resin manufacturing capacity?" },
      { "id": "a1_l2", "act": "act1", "start": 8.4375, "text": "Welcome to {MPD|M P D} Industries' state-of-the-art greenfield plant in {Ujjain|oo jane}." },
      { "id": "a1_l3", "act": "act1", "start": 15.0, "text": "Two plants on one site, commissioned together. {22|Twenty-two} reactors. Around {6,900|sixty-nine hundred} tons of rated output, every month." },

      { "id": "a2_l1", "act": "act2", "start": 31.875, "text": "Plant {1|one} specializes in high-volume liquid coating resins, driven by {16 KL|sixteen kiloliter} commercial powerhouses, on a site that scales from {2 KL|two kiloliter} pilot trials." },
      { "id": "a2_l2", "act": "act2", "start": 43.125, "text": "Saturated polyester, alkyds, and modified epoxy: {4,373|four thousand, three hundred and seventy-three} tons a month, from day one." },

      { "id": "a3_l1", "act": "act3", "start": 61.875, "text": "Plant {2|two} powers specialty and solid resins, backed by versatile finishing lines, including flakers, {pelletisers|pelletizers}, and product crushers." },
      { "id": "a3_l2", "act": "act3", "start": 73.125, "text": "Reactive polyamide, powder polyester, acrylic polyols, phenolics, and {R&D|R and D} scale-up: {2,530|two thousand, five hundred and thirty} tons a month." },

      { "id": "a4_l1", "act": "act4", "start": 91.875, "text": "Logistics are built for scale, with {600 KL|six hundred kiloliters} of underground {PESO|peso} solvent storage, and over {1,000 KL|one thousand kiloliters} of dedicated finished-goods tanks." },
      { "id": "a4_l2", "act": "act4", "start": 105.0, "text": "Twelve blenders add {380 KL|three hundred and eighty kiloliters} of blending capacity, and grade-dedicated tanks keep every product clean." },

      { "id": "a5_l1", "act": "act5", "start": 121.875, "text": "Built on eco-friendly power, driven by agro-waste thermic heaters, nitrogen blanketing, and zero-compromise {ETP|E T P} effluent treatment." },
      { "id": "a5_l2", "act": "act5", "start": 133.125, "text": "Two {30 lakh kcal/h|thirty lack kilocalorie} thermic heaters, a {2,200 TR|twenty-two hundred T R} cooling tower, and on-site nitrogen generation, sized for full load." },

      { "id": "a6_l1", "act": "act6", "start": 151.875, "text": "Whether you need toll conversion, full-service {jobwork|job work}, or dedicated plant capacity, partner with {MPD|M P D} Industries today." },
      { "id": "a6_l2", "act": "act6", "start": 161.25, "text": "Every model comes with {NDA|N D A} confidentiality, segregated storage, and a scale-up path from {2 KL|two kiloliter} trials to {16 KL|sixteen kiloliter} production." },
      { "id": "a6_l3", "act": "act6", "start": 172.5, "text": "{MPD|M P D} Industries. We innovate. We serve." }
    ]
  },

