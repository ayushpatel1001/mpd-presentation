# Dependencies (restore with `npm install`)
node_modules/

# Heavy, regenerable build artefacts:
# mix stems are 50-70 MB WAVs each, rebuilt by scripts/audio.py in ~1 min
build/audio/
# 5,400 rendered JPEG frames, rebuilt by scripts/render_frames.mjs
build/frames/
# validation captures + report, rebuilt by scripts/validate.mjs
build/validation/
# render / validation logs
build/logs/
# encoder outputs over GitHub's 100 MB limit (the committed master is re-encoded below it)
out/*_music_only.mp4
out/*_crf20.mp4

# Scratch
*.tmp
__pycache__/
.DS_Store
